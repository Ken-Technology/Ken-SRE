[Unit]
Description=Ken deployment transaction slot 1
Requires=ken-actions-guest-firewall.service ken-actions-guest-runtime-verify.service
After=ken-actions-guest-firewall.service ken-actions-guest-runtime-verify.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Slice=ken-actions-deploy-transaction-1.slice
ExecStart=/usr/local/libexec/ken-actions/ken-actions-deploy-transaction run-ordinary-slot --slot 1
RuntimeDirectory=ken-actions-deploy
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
TimeoutStartSec=3600
TimeoutStopSec=120
KillMode=mixed
NoNewPrivileges=no
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL CAP_SETGID CAP_SETUID
AmbientCapabilities=
SecureBits=noroot-locked
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectProc=default
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service @process @network-io setuid setgid setgroups prctl
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/ken-op-broker /usr/local/bin/ken-op-broker /usr/local/libexec/ken-actions
ReadWritePaths=/run/ken-actions-deploy /var/lib/ken-op-broker
MemoryMax=3584M
MemorySwapMax=0
CPUQuota=125%
TasksMax=384
LimitNOFILE=1024
LimitNPROC=384
