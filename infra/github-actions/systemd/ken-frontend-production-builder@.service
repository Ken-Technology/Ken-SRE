[Unit]
Description=Ken frontend rootless production builder %i
Requires=ken-actions-guest-firewall.service ken-actions-guest-runtime-verify.service
After=ken-actions-guest-firewall.service ken-actions-guest-runtime-verify.service
ConditionPathIsDirectory=/run/ken-op-broker/production/requests/%i

[Service]
Type=simple
User=ken-fe-builder
Group=ken-fe-builder
UMask=0077
Slice=ken-actions-deploy-builder.slice
ExecStart=/usr/local/bin/rootlesskit --net=slirp4netns --disable-host-loopback --copy-up=/etc --copy-up=/run /usr/local/bin/buildkitd --rootless --addr unix:///run/ken-op-broker/production/requests/%i/buildkitd.sock --root /run/ken-op-broker/production/requests/%i/buildkit
RuntimeDirectory=ken-frontend-builder/%i
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
Environment=HOME=/run/ken-op-broker/production/requests/%i/home PATH=/usr/local/bin:/usr/bin:/bin BUILDKITD_FLAGS=--oci-worker-no-process-sandbox
ReadWritePaths=/run/ken-op-broker/production/requests/%i
MemoryMax=8G
MemorySwapMax=0
CPUQuota=300%
TasksMax=1024
LimitCORE=0
LimitNOFILE=4096
TimeoutStartSec=1800s
TimeoutStopSec=30s
KillMode=control-group
