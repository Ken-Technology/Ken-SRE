#!/usr/bin/env bash
set -euo pipefail

readonly RUNNER_BASE="${KEN_RUNNER_BASE:-/var/lib/ken-runners}"
readonly RUNTIME_BASE="${KEN_RUNNER_RUNTIME_BASE:-/run/ken-rootless-docker}"
readonly STATE_BASE="${KEN_RUNNER_STATE_BASE:-/var/lib/ken-runner-state}"
readonly DOCKER_BIN="${KEN_RUNNER_DOCKER_BIN:-/usr/bin/docker}"

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

record_failure() {
  cleanup_failed=1
  printf 'CLEANUP_SUBSTEP_FAILED: %s\n' "$*" >&2
}

stat_uid() {
  stat -c '%u' -- "$1" 2>/dev/null || stat -f '%u' "$1"
}

stat_device() {
  stat -c '%d' -- "$1" 2>/dev/null || stat -f '%d' "$1"
}

stat_mode() {
  stat -c '%a' -- "$1" 2>/dev/null || stat -f '%Lp' "$1"
}

canonical_path() {
  if readlink -e -- "$1" 2>/dev/null; then
    return
  fi
  python3 - "$1" <<'PY'
import os
import sys

path = os.path.realpath(sys.argv[1])
if not os.path.exists(path):
    raise SystemExit(1)
print(path)
PY
}

validate_marker_if_present() {
  local marker="$1"
  if [[ -e "${marker}" || -L "${marker}" ]]; then
    [[ -f "${marker}" && ! -L "${marker}" ]] || die "runner state marker is not a regular file: ${marker}"
    [[ "$(stat_uid "${marker}")" == "${state_owner}" ]] || die "runner state marker owner mismatch: ${marker}"
    [[ "$(stat_mode "${marker}")" == 600 ]] || die "runner state marker mode mismatch: ${marker}"
  fi
}

write_marker() {
  local marker="$1"
  local temporary="${marker}.tmp.$$"
  [[ ! -e "${temporary}" && ! -L "${temporary}" ]] || die 'runner state temporary marker already exists'
  (umask 077 && : >"${temporary}") || die 'cannot create runner state marker'
  mv -f "${temporary}" "${marker}" || die 'cannot publish runner state marker'
  [[ "$(stat_uid "${marker}")" == "${state_owner}" && "$(stat_mode "${marker}")" == 600 ]] || die 'runner state marker permissions are invalid'
}

mark_dirty_state() {
  validate_marker_if_present "${dirty_marker}"
  validate_marker_if_present "${clean_marker}"
  write_marker "${dirty_marker}"
  rm -f "${clean_marker}"
}

mark_clean_state() {
  validate_marker_if_present "${dirty_marker}"
  validate_marker_if_present "${clean_marker}"
  write_marker "${clean_marker}"
  rm -f "${dirty_marker}"
}

[[ $# == 3 ]] || die 'usage: ken-runner-cleanup MODE RUNNER_NAME RUNNER_UID'
mode="$1"
runner_name="$2"
runner_uid="$3"
case "${mode}" in
  cleanup|recover|assert-clean|mark-dirty) ;;
  *) die 'cleanup mode must be cleanup, recover, assert-clean, or mark-dirty' ;;
esac
[[ "${runner_name}" =~ ^ken-(ci-standard-0[1-8]|ci-heavy-0[12]|deploy-(nonproduction|production)-01)$ ]] || die 'invalid runner name'
[[ "${runner_uid}" =~ ^[0-9]+$ ]] || die 'runner UID must be numeric'

test_mode=0
state_owner=0
if [[ "${KEN_RUNNER_CLEANUP_ALLOW_NON_ROOT:-0}" == 1 ]]; then
  test_mode=1
  state_owner="${EUID}"
else
  (( EUID == 0 )) || die 'cleanup must run as root'
  script_uid="$(stat_uid "${BASH_SOURCE[0]}")"
  script_mode="$(stat_mode "${BASH_SOURCE[0]}")"
  [[ "${script_uid}" == 0 ]] || die 'cleanup program is not root-owned'
  (( (8#${script_mode} & 0022) == 0 )) || die 'cleanup program is group/other writable'
fi

state_canonical="$(canonical_path "${STATE_BASE}")" || die 'runner state base is missing'
[[ -d "${STATE_BASE}" && ! -L "${STATE_BASE}" ]] || die 'runner state base is not an exact directory'
[[ "$(stat_uid "${STATE_BASE}")" == "${state_owner}" ]] || die 'runner state base owner mismatch'
state_mode="$(stat_mode "${STATE_BASE}")"
(( (8#${state_mode} & 0022) == 0 )) || die 'runner state base is group/other writable'
dirty_marker="${state_canonical}/${runner_name}.dirty"
clean_marker="${state_canonical}/${runner_name}.clean"

if [[ "${mode}" == assert-clean ]]; then
  validate_marker_if_present "${dirty_marker}"
  validate_marker_if_present "${clean_marker}"
  [[ -f "${clean_marker}" && ! -L "${clean_marker}" && ! -e "${dirty_marker}" && ! -L "${dirty_marker}" ]] || die 'runner clean-state admission gate is closed'
  printf 'CLEAN_STATE_OK=%s\n' "${runner_name}"
  exit 0
fi

if [[ "${mode}" == mark-dirty ]]; then
  mark_dirty_state
  printf 'RUNNER_DIRTY=%s\n' "${runner_name}"
  exit 0
fi

# Cleanup and recovery both publish dirty evidence before inspecting mutable
# runner state. Only a completely successful pass replaces it with clean.
mark_dirty_state

base_canonical="$(canonical_path "${RUNNER_BASE}")" || die 'runner base is missing'
runner_root="${RUNNER_BASE}/${runner_name}"
runner_canonical="$(canonical_path "${runner_root}")" || die 'runner root is missing'
[[ "${runner_canonical}" == "${base_canonical}/${runner_name}" ]] || die 'runner root resolves outside the approved base'
[[ -d "${runner_root}" && ! -L "${runner_root}" ]] || die 'runner root is a symlink or not a directory'
[[ "$(stat_uid "${runner_root}")" == "${runner_uid}" ]] || die 'runner root owner mismatch'

root_device="$(stat_device "${runner_root}")"
expected_device="${KEN_RUNNER_EXPECTED_DEVICE:-${root_device}}"
[[ "${root_device}" == "${expected_device}" ]] || die 'runner root device mismatch'

children=(home runner work)
if [[ "${runner_name}" == ken-ci-* ]]; then
  children+=(docker)
fi
for child in "${children[@]}"; do
  path="${runner_root}/${child}"
  [[ -d "${path}" && ! -L "${path}" ]] || die "runner ${child} path is a symlink or not a directory"
  canonical="$(canonical_path "${path}")" || die "runner ${child} path is missing"
  [[ "${canonical}" == "${runner_canonical}/${child}" ]] || die "runner ${child} path resolves outside the runner root"
  expected_child_owner="${runner_uid}"
  if [[ "${child}" == runner ]]; then
    expected_child_owner="${state_owner}"
  fi
  [[ "$(stat_uid "${path}")" == "${expected_child_owner}" ]] || die "runner ${child} owner mismatch"
  [[ "$(stat_device "${path}")" == "${expected_device}" ]] || die "runner ${child} device mismatch"
done

cleanup_failed=0
if [[ "${runner_name}" == ken-ci-* ]]; then
  docker_ready=1
  runtime_root="${RUNTIME_BASE}/${runner_name}"
  if ! runtime_base_canonical="$(canonical_path "${RUNTIME_BASE}")"; then
    record_failure 'rootless Docker runtime base is missing'
    docker_ready=0
  elif [[ ! -e "${runtime_root}" && ! -L "${runtime_root}" ]]; then
    record_failure 'rootless Docker runtime is missing'
    docker_ready=0
  else
    runtime_canonical="$(canonical_path "${runtime_root}")" || die 'rootless Docker runtime cannot be resolved'
    [[ "${runtime_canonical}" == "${runtime_base_canonical}/${runner_name}" ]] || die 'rootless Docker runtime resolves outside the approved base'
    [[ -d "${runtime_root}" && ! -L "${runtime_root}" ]] || die 'rootless Docker runtime is a symlink or not a directory'
    [[ "$(stat_uid "${runtime_root}")" == "${runner_uid}" ]] || die 'rootless Docker runtime owner mismatch'
    runtime_device="$(stat_device "${runtime_root}")"
    expected_runtime_device="${KEN_RUNNER_EXPECTED_RUNTIME_DEVICE:-$(stat_device "${RUNTIME_BASE}")}"
    [[ "${runtime_device}" == "${expected_runtime_device}" ]] || die 'rootless Docker runtime device mismatch'
    docker_socket="${runtime_root}/docker.sock"
    if (( test_mode == 1 )) && [[ "${KEN_RUNNER_CLEANUP_TEST_SOCKET_FILE:-0}" == 1 ]]; then
      if [[ ! -f "${docker_socket}" || -L "${docker_socket}" ]]; then
        record_failure 'rootless Docker test socket stand-in is invalid'
        docker_ready=0
      fi
    elif [[ ! -S "${docker_socket}" || -L "${docker_socket}" ]]; then
      record_failure 'rootless Docker socket is invalid'
      docker_ready=0
    fi
    if (( docker_ready == 1 )); then
      [[ "$(stat_uid "${docker_socket}")" == "${runner_uid}" ]] || die 'rootless Docker socket owner mismatch'
      [[ "$(stat_device "${docker_socket}")" == "${expected_runtime_device}" ]] || die 'rootless Docker socket device mismatch'
    fi
  fi

  if (( docker_ready == 1 )); then
    docker_host="unix://${docker_socket}"

    container_output=''
    if ! container_output="$("${DOCKER_BIN}" --host "${docker_host}" ps -aq)"; then
      record_failure 'cannot list runner containers'
    else
      while IFS= read -r identifier; do
        [[ -z "${identifier}" ]] && continue
        if [[ ! "${identifier}" =~ ^[A-Za-z0-9_.:-]+$ ]]; then
          record_failure 'rootless Docker returned an invalid container ID'
          continue
        fi
        "${DOCKER_BIN}" --host "${docker_host}" rm -f "${identifier}" || record_failure "cannot remove runner container ${identifier}"
      done <<<"${container_output}"
    fi

    network_output=''
    if ! network_output="$("${DOCKER_BIN}" --host "${docker_host}" network ls --filter type=custom --format '{{.ID}} {{.Name}}')"; then
      record_failure 'cannot list runner custom networks'
    else
      while read -r identifier network_name extra; do
        [[ -z "${identifier}" && -z "${network_name}" ]] && continue
        if [[ -n "${extra:-}" || ! "${identifier}" =~ ^[A-Za-z0-9_.:-]+$ || ! "${network_name}" =~ ^[A-Za-z0-9_.-]+$ ]]; then
          record_failure 'rootless Docker returned invalid network metadata'
          continue
        fi
        case "${network_name}" in
          bridge|host|none) continue ;;
        esac
        "${DOCKER_BIN}" --host "${docker_host}" network rm "${identifier}" || record_failure "cannot remove runner network ${identifier}"
      done <<<"${network_output}"
    fi

    volume_output=''
    if ! volume_output="$("${DOCKER_BIN}" --host "${docker_host}" volume ls -q)"; then
      record_failure 'cannot list runner volumes'
    else
      while IFS= read -r identifier; do
        [[ -z "${identifier}" ]] && continue
        if [[ ! "${identifier}" =~ ^[A-Za-z0-9_.:-]+$ ]]; then
          record_failure 'rootless Docker returned an invalid volume ID'
          continue
        fi
        "${DOCKER_BIN}" --host "${docker_host}" volume rm -f "${identifier}" || record_failure "cannot remove runner volume ${identifier}"
      done <<<"${volume_output}"
    fi
  fi
fi

work_root="${runner_root}/work"
work_canonical="$(canonical_path "${work_root}")" || die 'runner work path disappeared before cleanup'
[[ "${work_canonical}" == "${runner_canonical}/work" && -d "${work_root}" && ! -L "${work_root}" ]] || die 'runner work path changed before cleanup'
[[ "$(stat_uid "${work_root}")" == "${runner_uid}" ]] || die 'runner work owner changed before cleanup'
[[ "$(stat_device "${work_root}")" == "${expected_device}" ]] || die 'runner work device changed before cleanup'
find "${work_root}" -xdev -mindepth 1 -delete || record_failure 'cannot delete the bounded runner workspace'

if (( cleanup_failed != 0 )); then
  printf 'RUNNER_DIRTY=%s\n' "${runner_name}" >&2
  exit 1
fi

mark_clean_state
if [[ "${mode}" == recover ]]; then
  printf 'RECOVERY_OK=%s\n' "${runner_name}"
else
  printf 'CLEANUP_OK=%s\n' "${runner_name}"
fi
