[Unit]
Description=Ken frontend source-map uploader %i
Requires=ken-actions-guest-firewall.service ken-actions-guest-runtime-verify.service
After=ken-frontend-production-builder@%i.service ken-actions-guest-firewall.service ken-actions-guest-runtime-verify.service
Conflicts=ken-frontend-production-builder@%i.service

[Service]
Type=oneshot
User=ken-fe-uploader
Group=ken-fe-uploader
UMask=0077
Slice=ken-actions-deploy-uploader.slice
ExecStart=/usr/local/bin/ken-frontend-source-map-upload --endpoint https://us.posthog.com/api/projects/413585/releases --archive-fd 3 --project-id-fd 4 --api-key-fd 5
StandardOutput=null
StandardError=null
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
Environment=HOME=/nonexistent LANG=C.UTF-8 PATH=/usr/bin:/bin
MemoryMax=512M
MemorySwapMax=0
CPUQuota=50%
TasksMax=128
LimitCORE=0
TimeoutStartSec=300s
KillMode=control-group
