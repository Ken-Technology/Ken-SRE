            "seal": "sha256-canonical-json-read-only-fd", "repository_code_execution": False,
        },
        "trusted_generation_cgroup_contract_sha256": {
            "version": 1, "parent": "ken-actions-deploy.slice", "slots": [1, 2],
            "generate_scope": trusted["generate"]["cgroup_scope"], "push_scope": trusted["push"]["cgroup_scope"],
            "distinct_global_unit_names": True, "overlap": "forbidden",
        },
        "trusted_generation_phase_transport_sha256": trusted,
    }


def contract_sha256(contract: Any) -> str:
    return hashlib.sha256(json.dumps(contract, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode()).hexdigest()


def binding_digests() -> dict[str, str]:
    return {name: contract_sha256(contract) for name, contract in binding_contracts().items()}


def _regular_root_file(path: Path, *, maximum: int = 2 * 1024 * 1024) -> bytes:
    if path.is_symlink():
        raise TransportReject("root_file_invalid")
    status = path.stat()
    if not stat.S_ISREG(status.st_mode) or status.st_uid != 0 or status.st_mode & 0o022 or status.st_size > maximum:
        raise TransportReject("root_file_invalid")
    return path.read_bytes()


def _request_directory(root: Path, request_id: str) -> Path:
    if not SAFE_REQUEST_ID.fullmatch(request_id):
        raise TransportReject("request_id_invalid")
    request = root / "requests" / request_id
    root_real = (root / "requests").resolve(strict=True)
    request_real = request.resolve(strict=True)
    if request.is_symlink() or request_real.parent != root_real or not (request_real / ".ken-actions-request").is_file():
        raise TransportReject("request_directory_invalid")
    status = request_real.stat()
    if status.st_uid != 0 or stat.S_IMODE(status.st_mode) != 0o700:
        raise TransportReject("request_directory_invalid")
    return request_real


def _load_request(root: Path, request_id: str) -> tuple[Path, TransportRequest]:
    request_dir = _request_directory(root, request_id)
    raw = _regular_root_file(request_dir / "request.json", maximum=65536)
    request = TransportRequest.parse(raw)
    if request.request_id != request_id:
        raise TransportReject("request_identity_mismatch")
    return request_dir, request


def _load_policy(path: Path, expected_sha256: str) -> Mapping[str, Any]:
    raw = _regular_root_file(path, maximum=2 * 1024 * 1024)
    if hashlib.sha256(raw).hexdigest() != expected_sha256:
        raise TransportReject("policy_digest_mismatch")
    policy = strict_yaml(path)
    _exact_keys(policy, {
        "schema_version", "policy_version", "issuer", "discovery_url", "jwks_uri", "organization", "protocol", "jwks",
        "github_api", "artifact", "source_commit", "credentials", "deploy_leases", "firewall_phase_interface", "classes", "actions",
    }, "policy_schema_invalid")
    return policy


def _action(policy: Mapping[str, Any], action_id: str) -> Mapping[str, Any]:
    rows = [row for row in policy["actions"] if isinstance(row, dict) and row.get("action_id") == action_id]
    if len(rows) != 1:
        raise TransportReject("action_policy_invalid")
    return rows[0]


def _status_write(request_dir: Path, status: str, reason: str) -> None:
    if status not in {"succeeded", "failed"} or not SAFE_REASON.fullmatch(reason):
        raise TransportReject("status_invalid")
    path = request_dir / "transport-status.json"
    temporary = request_dir / ".transport-status.json.new"
    payload = json.dumps({"version": 1, "status": status, "reason_code": reason}, sort_keys=True, separators=(",", ":")).encode()
    fd = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        os.write(fd, payload); os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(temporary, path)


def _quiet_run(argv: Sequence[str], *, timeout: int, env: Mapping[str, str] | None = None, pass_fds: Sequence[int] = ()) -> None:
    result = subprocess.run(list(argv), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            env=dict(env or {"HOME": "/nonexistent", "LANG": "C.UTF-8", "PATH": "/usr/bin:/bin"}),
                            pass_fds=tuple(pass_fds), timeout=timeout, check=False)
    if result.returncode != 0:
        raise TransportReject("child_operation_failed")


def _atomic_json(path: Path, value: Mapping[str, Any], *, mode: int = 0o600) -> None:
    parent = path.parent
    if parent.is_symlink() or not parent.is_dir():
        raise TransportReject("authority_directory_invalid")
    parent_status = parent.stat()
    if parent_status.st_uid != 0 or stat.S_IMODE(parent_status.st_mode) != 0o700:
        raise TransportReject("authority_directory_invalid")
    temporary = path.with_name(f".{path.name}.{os.getpid()}.new")
    payload = json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
    fd = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0), mode)
    try:
        os.write(fd, payload); os.fsync(fd)
    finally:
        os.close(fd)
    os.replace(temporary, path)
    parent_fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0))
    try:
        os.fsync(parent_fd)
    finally:
        os.close(parent_fd)


def _firewall(request_dir: Path, request_id: str, profile: str, phase: str, state: str) -> None:
    if (state not in {"activate", "deactivate"} or (profile, phase) not in ALLOWED_FIREWALL_PHASES
            or not SAFE_ACTION_ID.fullmatch(profile.replace("_", "-")) or not SAFE_ACTION_ID.fullmatch(phase.replace("_", "-"))):
        raise TransportReject("firewall_request_invalid")
    if not SAFE_REQUEST_ID.fullmatch(request_id):
        raise TransportReject("firewall_request_invalid")
    descriptor = {"schema_version": 1, "request_id": request_id, "profile": profile, "phase": phase}
    request_file = FIREWALL_REQUEST_ROOT / f"{request_id}.json"
    active_marker = request_dir / ".firewall-phase.json"
    if state == "activate":
        if request_file.exists() or request_file.is_symlink() or active_marker.exists() or active_marker.is_symlink():
            raise TransportReject("firewall_phase_overlap")
        _atomic_json(request_file, descriptor)
        _atomic_json(active_marker, descriptor)
    else:
        try:
            current = _exact_keys(strict_json(active_marker.read_bytes(), maximum=4096), set(descriptor), "firewall_marker_invalid")
        except OSError as exc:
            raise TransportReject("firewall_marker_invalid") from exc
        if current != descriptor:
            raise TransportReject("firewall_marker_invalid")
    _quiet_run([FIREWALL_HELPER, "phase", "--request-id", request_id, "--profile", profile, "--phase", phase, "--state", state], timeout=30)
    if state == "deactivate":
        try:
            active_marker.unlink()
        except FileNotFoundError as exc:
            raise TransportReject("firewall_marker_invalid") from exc


def _recover_firewall(request_dir: Path, request_id: str) -> bool:
    marker = request_dir / ".firewall-phase.json"
    if not marker.exists() and not marker.is_symlink():
        return True
    try:
        value = _exact_keys(strict_json(marker.read_bytes(), maximum=4096), {
            "schema_version", "request_id", "profile", "phase",
        }, "firewall_marker_invalid")
        if type(value["schema_version"]) is not int or value["schema_version"] != 1 or value["request_id"] != request_id:
            return False
        _firewall(request_dir, request_id, str(value["profile"]), str(value["phase"]), "deactivate")
        return True
    except (OSError, TransportReject):
        return False


def _systemctl_property(unit: str, name: str) -> str:
    result = subprocess.run([SYSTEMCTL, "show", unit, f"--property={name}", "--value"], stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env={"LANG": "C.UTF-8", "PATH": "/usr/bin:/bin"},
                            timeout=15, check=False)
    if result.returncode != 0 or len(result.stdout) > 4096:
        raise TransportReject("systemd_readback_failed")
    try:
        return result.stdout.decode("utf-8").strip()
    except UnicodeError as exc:
        raise TransportReject("systemd_readback_failed") from exc


def _stop_and_verify_unit(unit: str) -> bool:
    result = subprocess.run([SYSTEMCTL, "stop", unit], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            env={"LANG": "C.UTF-8", "PATH": "/usr/bin:/bin"}, timeout=60, check=False)
    try:
        load = _systemctl_property(unit, "LoadState")
        active = _systemctl_property(unit, "ActiveState")
        control_group = _systemctl_property(unit, "ControlGroup")
    except TransportReject:
        return False
    if load == "not-found":
        return not control_group
    return result.returncode == 0 and active in {"inactive", "failed"} and not control_group


def _start_fixed_unit(unit: str, expected_slice: str, request_id: str | None = None) -> None:
    if _systemctl_property(unit, "Slice") != expected_slice:
        raise TransportReject("systemd_slice_mismatch")
    _quiet_run([SYSTEMCTL, "start", unit], timeout=3600)
    cgroup = _systemctl_property(unit, "ControlGroup")
    if cgroup:
        validate_cgroup(cgroup, expected_slice)
    if request_id and not SAFE_REQUEST_ID.fullmatch(request_id):
        raise TransportReject("request_id_invalid")


class LiveRecoveryRuntime:
    def __init__(self, state_root: Path):
        self.state_root = state_root

    def stop_and_reap(self, lease: LeaseHandle) -> bool:
        units = [ORDINARY_SLOTS[slot][0] for slot in lease.slots]
        units.extend(template.format(request_id=lease.request_id) for template, _, _ in FRONTEND_PHASES.values())
        for slot in lease.slots:
            units.extend((f"ken-beehiiv-generate-slot-{slot}.scope", f"ken-beehiiv-push-slot-{slot}.scope"))
        results = [_stop_and_verify_unit(unit) for unit in units]
        return all(results)

    def cleanup_request(self, lease: LeaseHandle) -> bool:
        try:
            request_path = self.state_root / "requests" / lease.request_id
            if not request_path.exists() and not request_path.is_symlink():
                return True
            request = _request_directory(self.state_root, lease.request_id)
            if not _recover_firewall(request, lease.request_id):
                return False
            shutil.rmtree(request)
            return True
        except (OSError, TransportReject):
            return False


def _current_control_group() -> str:
    try:
        for line in Path("/proc/self/cgroup").read_text().splitlines():
            fields = line.split(":", 2)
            if len(fields) == 3 and fields[0] == "0":
                return fields[2]
    except OSError as exc:
        raise TransportReject("cgroup_read_failed") from exc
    raise TransportReject("cgroup_read_failed")


def _open_descriptor(path: Path) -> int:
    if path.is_symlink():
        raise TransportReject("descriptor_file_invalid")
    fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0))
    status = os.fstat(fd)
    flags = fcntl.fcntl(fd, fcntl.F_GETFL)
    if (not stat.S_ISREG(status.st_mode) or status.st_uid != 0 or status.st_nlink != 1
            or status.st_mode & 0o022 or (flags & os.O_ACCMODE) != os.O_RDONLY):
        os.close(fd)
        raise TransportReject("descriptor_file_invalid")
    return fd


def _execute_ordinary(request_dir: Path, request: TransportRequest, action: Mapping[str, Any]) -> None:
    mode = action.get("input_mode")
    validate_descriptor_contract(str(mode), request.descriptors)
    executor = _exact_keys(action.get("executor"), {
        "name", "uid", "gid", "wrapper", "wrapper_sha256", "operation_binding_sha256",
        "systemd_transaction_transport_sha256", "timeout_seconds", "network_profile",
        *({"target_profile", "known_hosts_path", "known_hosts_sha256"} if "known_hosts_path" in (action.get("executor") or {}) else set()),
    }, "executor_policy_invalid")
    if type(executor["uid"]) is not int or type(executor["gid"]) is not int or executor["uid"] <= 0 or executor["gid"] <= 0:
        raise TransportReject("executor_identity_invalid")
    wrapper = Path(executor["wrapper"])
    if hashlib.sha256(_regular_root_file(wrapper, maximum=1024 * 1024)).hexdigest() != executor["wrapper_sha256"]:
        raise TransportReject("executor_wrapper_invalid")
    descriptor_root = request_dir / "descriptors"
    fds = [_open_descriptor(descriptor_root / name) for name in request.descriptors]
    profile = str(executor["network_profile"])
    try:
        input_fd, rendered_fd = fds
        for phase, operation in firewall_phase_plan(request.action_id):
            _firewall(request_dir, request.request_id, profile, phase, "activate")
            try:
                os.lseek(input_fd, 0, os.SEEK_SET); os.lseek(rendered_fd, 0, os.SEEK_SET)
                argv = [
                    "/usr/bin/setpriv", f"--reuid={executor['uid']}", f"--regid={executor['gid']}", "--clear-groups", "--no-new-privs",
                    str(wrapper), "--broker-action", request.action_id, "--operation", operation,
                    "--input-fd", str(input_fd), "--rendered-fd", str(rendered_fd),
                ]
                _quiet_run(argv, timeout=int(executor["timeout_seconds"]), env={
                    "HOME": "/nonexistent", "LANG": "C.UTF-8", "PATH": "/usr/bin:/bin",
                    "REQUEST_ID": request.request_id, "SOURCE_SHA": request.source_sha,
                }, pass_fds=fds)
            finally:
                _firewall(request_dir, request.request_id, profile, phase, "deactivate")
    finally:
        for fd in fds:
            try:
                os.close(fd)
            except OSError:
                pass


def _safe_copy_tree(source: Path, destination: Path, *, owner_uid: int, owner_gid: int, maximum_files: int, maximum_bytes: int) -> None:
    if source.is_symlink() or not source.is_dir() or destination.exists():
        raise TransportReject("trusted_source_invalid")
    destination.mkdir(mode=0o700, parents=True)
    count = 0
    total = 0
    for directory, names, files in os.walk(source, topdown=True, followlinks=False):
        names.sort(); files.sort()
        relative = Path(directory).relative_to(source)
        target_directory = destination / relative
        if Path(directory).is_symlink() or any((Path(directory) / name).is_symlink() for name in names):
            raise TransportReject("trusted_source_invalid")
        target_directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        os.chown(target_directory, owner_uid, owner_gid)
        for name in files:
            source_file = Path(directory) / name
            if source_file.is_symlink():
                raise TransportReject("trusted_source_invalid")
            status = source_file.stat()
            mode = stat.S_IMODE(status.st_mode)
            if not stat.S_ISREG(status.st_mode) or status.st_nlink != 1 or mode not in {0o440, 0o444, 0o550, 0o555}:
                raise TransportReject("trusted_source_invalid")
            count += 1; total += status.st_size
            if count > maximum_files or total > maximum_bytes:
                raise TransportReject("trusted_source_limit")
            target = target_directory / name
            source_fd = os.open(source_file, os.O_RDONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0))
            target_fd = os.open(target, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0), 0o700 if mode & 0o111 else 0o600)
            try:
                while True:
                    chunk = os.read(source_fd, 1024 * 1024)
                    if not chunk:
                        break
                    os.write(target_fd, chunk)
                os.fsync(target_fd)
            finally:
                os.close(source_fd); os.close(target_fd)
            os.chown(target, owner_uid, owner_gid)


def validate_offline_store(root: Path, *, owner_uid: int = 0, reader_gid: int = 22102) -> None:
    """Require an immutable, recursively generator-readable pnpm store."""
    if root.is_symlink() or not root.is_dir():
        raise TransportReject("trusted_dependency_store_invalid")
    count = 0
    total = 0
    for directory, names, files in os.walk(root, topdown=True, followlinks=False):
        names.sort(); files.sort()
        path = Path(directory)
        status = path.stat()
        if (path.is_symlink() or not stat.S_ISDIR(status.st_mode) or status.st_uid != owner_uid
                or status.st_gid != reader_gid or stat.S_IMODE(status.st_mode) != 0o550
                or any((path / name).is_symlink() for name in names)):
            raise TransportReject("trusted_dependency_store_invalid")
        for name in files:
            item = path / name
            if item.is_symlink():
                raise TransportReject("trusted_dependency_store_invalid")
            item_status = item.stat()
            if (not stat.S_ISREG(item_status.st_mode) or item_status.st_nlink != 1
                    or item_status.st_uid != owner_uid or item_status.st_gid != reader_gid
                    or stat.S_IMODE(item_status.st_mode) != 0o440):
                raise TransportReject("trusted_dependency_store_invalid")
            count += 1; total += item_status.st_size
            if count > 250000 or total > 4 * 1024 * 1024 * 1024:
                raise TransportReject("trusted_dependency_store_limit")


def _tree_snapshot(root: Path) -> dict[str, dict[str, Any]]:
    if root.is_symlink() or not root.is_dir():
        raise TransportReject("generated_tree_invalid")
    result: dict[str, dict[str, Any]] = {}
    total = 0
    for directory, names, files in os.walk(root, topdown=True, followlinks=False):
        names.sort(); files.sort()
        base = Path(directory)
        if base.is_symlink() or any((base / name).is_symlink() for name in names):
            raise TransportReject("generated_tree_invalid")
        for name in files:
            path = base / name
            if path.is_symlink():
                raise TransportReject("generated_tree_invalid")
            status = path.stat()
            if not stat.S_ISREG(status.st_mode) or status.st_nlink != 1:
                raise TransportReject("generated_tree_invalid")
            relative = path.relative_to(root).as_posix()
            mode = stat.S_IMODE(status.st_mode)
            if mode not in {0o600, 0o644, 0o700, 0o755}:
                raise TransportReject("generated_tree_invalid")
            digest = hashlib.sha256()
            with path.open("rb") as handle:
                for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                    digest.update(chunk)
            total += status.st_size
            if len(result) >= 100000 or total > 2 * 1024 * 1024 * 1024:
                raise TransportReject("generated_tree_limit")
            result[relative] = {"mode": "100755" if mode & 0o111 else "100644", "size": status.st_size, "sha256": digest.hexdigest()}
    return result


def trusted_scope_state(request_id: str, slot: int, active_role: str | None) -> dict[str, Any]:
    if (not SAFE_REQUEST_ID.fullmatch(request_id) or slot not in ORDINARY_SLOTS
            or active_role not in {None, "generate", "push"}):
        raise TransportReject("trusted_scope_state_invalid")
    return {
        "schema_version": 1, "request_id": request_id, "slot": slot,
        "scopes": {
            "generate": f"ken-beehiiv-generate-slot-{slot}.scope",
            "push": f"ken-beehiiv-push-slot-{slot}.scope",
        },
        "active_role": active_role,
    }


def run_trusted_phase(role: str, slot: int, request_id: str, descriptors: Sequence[int], parent_sha: str | None) -> None:
    """In-scope admission gate executed as the fixed transient phase UID."""
    if slot not in ORDINARY_SLOTS or not SAFE_REQUEST_ID.fullmatch(request_id):
        raise TransportReject("trusted_phase_admission_invalid")
    scope_role = "push" if role == "push" else "generate"
    expected_uid = 22104 if scope_role == "push" else 22102
    if role not in {"dependency", "generate", "push"} or os.geteuid() != expected_uid:
        raise TransportReject("trusted_phase_identity_invalid")
    if len(descriptors) != 2 or any(type(fd) is not int or fd < 3 for fd in descriptors):
        raise TransportReject("trusted_phase_descriptor_invalid")
    unit = f"ken-beehiiv-{scope_role}-slot-{slot}.scope"
    expected_slice = ORDINARY_SLOTS[slot][1]
    if _systemctl_property(unit, "Slice") != expected_slice:
        raise TransportReject("trusted_phase_slice_invalid")
    control_group = _current_control_group()
    validate_cgroup(control_group, expected_slice)
    if control_group.rstrip("/").split("/")[-1] != unit:
        raise TransportReject("trusted_phase_scope_invalid")
    first_fd, second_fd = descriptors
    if role == "dependency":
        argv = [
            TOOLCHAIN_NODE, TOOLCHAIN_PNPM, "install", "--offline", "--frozen-lockfile", "--ignore-scripts",
            "--dir", f"/proc/self/fd/{first_fd}", "--store-dir", f"/proc/self/fd/{second_fd}",
        ]
        timeout = 900
    elif role == "generate":
        if parent_sha is not None:
            raise TransportReject("trusted_phase_parent_invalid")
        argv = [TRUSTED_HELPER_PATH, "generate", "--source-fd", str(first_fd), "--rendered-fd", str(second_fd)]
        timeout = 900
    else:
        if parent_sha is None or not SHA1.fullmatch(parent_sha):
            raise TransportReject("trusted_phase_parent_invalid")
        argv = [TRUSTED_HELPER_PATH, "push", "--commit-input-fd", str(first_fd), "--rendered-fd", str(second_fd), "--parent-sha", parent_sha]
        timeout = 600
    _quiet_run(argv, timeout=timeout, pass_fds=descriptors)


class LiveTrustedGenerationRuntime:
    """Linux runtime adapter for the two non-overlapping Beehiiv phases."""

    def __init__(self, request_dir: Path, request: TransportRequest, action: Mapping[str, Any], slot: int):
        if slot not in ORDINARY_SLOTS:
            raise TransportReject("trusted_generation_slot_invalid")
        self.request_dir = request_dir
        self.request = request
        self.action = action
        self.slot = slot
        self.trusted_root = request_dir / "trusted"
        self.source = self.trusted_root / "source"
        self.generate_root = self.trusted_root / "generate"
        self.push_root = self.trusted_root / "push"
        self.worktree = self.generate_root / "worktree"
        self.open_fds: list[int] = []
        self.active: str | None = None
        self.completed: set[str] = set()
        self.scope_state_path = request_dir / ".trusted-scopes.json"
        if self.scope_state_path.exists() or self.scope_state_path.is_symlink():
            raise TransportReject("trusted_scope_state_exists")
        self._write_scope_state(None)
        generation = action.get("trusted_generation") or {}
        transport = generation.get("transport") or {}
        self.helper = Path(str(transport.get("wrapper") or ""))
        expected = str(transport.get("wrapper_sha256") or "")
        if (self.helper != Path(TRUSTED_HELPER_PATH) or not SHA256.fullmatch(expected)
                or hashlib.sha256(_regular_root_file(self.helper, maximum=1024 * 1024)).hexdigest() != expected):
            raise TransportReject("trusted_generation_wrapper_invalid")

    def assert_inactive(self) -> None:
        if self.active is not None:
            raise TransportReject("trusted_generation_overlap")

    def _scope(self, role: str) -> tuple[str, str]:
        if role not in {"generate", "push"}:
            raise TransportReject("trusted_generation_phase_invalid")
        unit = f"ken-beehiiv-{role}-slot-{self.slot}.scope"
        return unit, ORDINARY_SLOTS[self.slot][1]

    def _write_scope_state(self, active_role: str | None) -> None:
        _atomic_json(self.scope_state_path, trusted_scope_state(self.request.request_id, self.slot, active_role))

    def _run_scope(self, scope_role: str, phase_role: str, identity: Mapping[str, Any], descriptors: Sequence[int],
                   *, timeout: int, parent_sha: str | None = None) -> None:
        self.assert_inactive()
        if len(descriptors) != 2 or any(type(fd) is not int or fd < 3 for fd in descriptors):
            raise TransportReject("trusted_phase_descriptor_invalid")
        contract_role = "push" if scope_role == "push" else "generate"
        if identity != trusted_generation_contract()[contract_role]["identity"]:
            raise TransportReject("trusted_generation_identity_invalid")
        unit, slice_name = self._scope(scope_role)
        self._write_scope_state(scope_role)
        self.active = scope_role
        child = [
            TRANSPORT_PATH, "run-trusted-phase", "--role", phase_role, "--slot", str(self.slot),
            "--request-id", self.request.request_id, "--first-fd", str(descriptors[0]), "--second-fd", str(descriptors[1]),
        ]
        if parent_sha is not None:
            child.extend(("--parent-sha", parent_sha))
        command = [
            "/usr/bin/systemd-run", "--quiet", "--scope", "--wait", f"--unit={unit.removesuffix('.scope')}", f"--slice={slice_name}",
            "/usr/bin/setpriv", f"--reuid={identity['uid']}", f"--regid={identity['gid']}", "--clear-groups", "--no-new-privs", *child,
        ]
        _quiet_run(command, timeout=timeout, pass_fds=descriptors)
        self.completed.add(phase_role)

    def prepare_dependencies(self, spec: Mapping[str, Any]) -> None:
        self.assert_inactive()
        if spec != trusted_generation_contract()["dependency"]:
            raise TransportReject("trusted_dependency_contract_invalid")
        self.generate_root.mkdir(mode=0o700, parents=True, exist_ok=False)
        self.push_root.mkdir(mode=0o700, parents=True, exist_ok=False)
        _safe_copy_tree(self.source, self.worktree, owner_uid=22102, owner_gid=22102, maximum_files=100000, maximum_bytes=2 * 1024 * 1024 * 1024)
        offline_store = self.trusted_root / "offline-pnpm-store"
        validate_offline_store(offline_store)
        worktree_fd = os.open(self.worktree, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0))
        store_fd = os.open(offline_store, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0))
        try:
            self._run_scope("generate", "dependency", spec["identity"], (worktree_fd, store_fd), timeout=900)
            self.stop_and_reap("generate")
        finally:
            os.close(worktree_fd); os.close(store_fd)
        self.dependency_baseline = _tree_snapshot(self.worktree)

    def start_generate(self, spec: Mapping[str, Any]) -> None:
        if spec != trusted_generation_contract()["generate"] or "dependency" not in self.completed:
            raise TransportReject("trusted_generate_contract_invalid")
        rendered = _open_descriptor(self.generate_root / "rendered.env")
        source_fd = os.open(self.worktree, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        self.open_fds.extend((source_fd, rendered))
        _firewall(self.request_dir, self.request.request_id, spec["network_profile"], spec["firewall_phase"], "activate")
        self._run_scope("generate", "generate", spec["identity"], (source_fd, rendered), timeout=900)

    def stop_and_reap(self, role: str) -> None:
        if self.active != role:
            raise TransportReject("trusted_generation_reap_invalid")
        unit, _ = self._scope(role)
        if not _stop_and_verify_unit(unit):
            raise TransportReject("trusted_generation_reap_invalid")
        if not _recover_firewall(self.request_dir, self.request.request_id):
            raise TransportReject("trusted_generation_firewall_reap_invalid")
        self._write_scope_state(None)
        self.active = None

    def generated_diff(self) -> list[dict[str, Any]]:
        self.assert_inactive()
        if "generate" not in self.completed:
            raise TransportReject("trusted_generation_incomplete")
        if not hasattr(self, "dependency_baseline"):
            raise TransportReject("trusted_dependency_baseline_missing")
        generated = _tree_snapshot(self.worktree)
        return generated_diff_from_snapshots(self.dependency_baseline, generated)

    def seal_commit_input(self, entries: Sequence[Mapping[str, Any]]) -> Path:
        self.assert_inactive()
        validate_generated_diff(list(entries))
        manifest = {
            "version": 1, "action_id": self.request.action_id, "parent_sha": self.request.source_sha,
            "author": "ken-blog-sync[bot] <blog-sync@getken.ai>", "message": "content: sync beehiiv posts", "entries": list(entries),
        }
        manifest_bytes = json.dumps(manifest, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode()
        archive = self.push_root / "verified-commit-input.tar"
        if archive.exists() or archive.is_symlink():
            raise TransportReject("commit_input_exists")
        with tarfile.open(archive, "x", format=tarfile.PAX_FORMAT) as bundle:
            info = tarfile.TarInfo("manifest.json"); info.size = len(manifest_bytes); info.mode = 0o400; info.mtime = 0; info.uid = 0; info.gid = 0
            bundle.addfile(info, io.BytesIO(manifest_bytes))
            for entry in entries:
                if entry["type"] == "delete":
                    continue
                source = self.worktree / entry["path"]
                status = source.stat()
                if (source.is_symlink() or not stat.S_ISREG(status.st_mode) or status.st_size != entry["size"]
                        or hashlib.sha256(source.read_bytes()).hexdigest() != entry["sha256"]):
                    raise TransportReject("commit_input_drift")
                member = tarfile.TarInfo("files/" + entry["path"]); member.size = status.st_size; member.mode = 0o400; member.mtime = 0; member.uid = 0; member.gid = 0
                with source.open("rb") as handle:
                    bundle.addfile(member, handle)
        os.chmod(archive, 0o400)
        if archive.stat().st_uid != 0:
            raise TransportReject("commit_input_owner_invalid")
        return archive

    def close_generate_descriptors(self) -> None:
        for fd in self.open_fds:
            try:
                os.close(fd)
            except OSError:
                pass
        self.open_fds.clear()

    def start_push(self, spec: Mapping[str, Any], sealed: Path) -> None:
        if spec != trusted_generation_contract()["push"] or self.open_fds or "generate" not in self.completed:
            raise TransportReject("trusted_push_contract_invalid")
        commit_fd = _open_descriptor(sealed)
        rendered_fd = _open_descriptor(self.push_root / "rendered.env")
        self.open_fds.extend((commit_fd, rendered_fd))
        _firewall(self.request_dir, self.request.request_id, spec["network_profile"], spec["firewall_phase"], "activate")
        self._run_scope("push", "push", spec["identity"], (commit_fd, rendered_fd), timeout=600, parent_sha=self.request.source_sha)

    def close_push_descriptors(self) -> None:
        self.close_generate_descriptors()

    def abort_cleanup(self) -> None:
        results = [_stop_and_verify_unit(self._scope(role)[0]) for role in ("generate", "push")]
        if not all(results) or not _recover_firewall(self.request_dir, self.request.request_id):
            raise TransportReject("trusted_generation_abort_reap_failed")
        self._write_scope_state(None)
        self.close_generate_descriptors()
        self.active = None


def _lease_for_slot(scheduler: LeaseScheduler, slot: int) -> LeaseHandle:
    marker = scheduler._slot_path(slot)
    if not marker.exists():
        raise TransportReject("lease_marker_missing")
    handle = scheduler._read_marker(marker)
    if slot not in handle.slots:
        raise TransportReject("lease_slot_mismatch")
    return handle


def run_ordinary_slot(slot: int, state_root: Path, policy_path: Path) -> None:
    if os.geteuid() != 0:
        raise TransportReject("coordinator_not_root")
    expected_slice = ORDINARY_SLOTS[slot][1]
    validate_cgroup(_current_control_group(), expected_slice)
    scheduler = LeaseScheduler(state_root / "leases")
    lease = _lease_for_slot(scheduler, slot)
    request_dir, request = _load_request(state_root, lease.request_id)
    policy = _load_policy(policy_path, request.policy_sha256)
    action = _action(policy, request.action_id)
    if action.get("enabled") is not True:
        raise TransportReject("action_not_enabled")
    mode = action.get("input_mode")
    runtime = LiveTrustedGenerationRuntime(request_dir, request, action, slot) if mode == "trusted_generation" else None
    execute_action_mode(mode, slot=slot, ordinary=lambda: _execute_ordinary(request_dir, request, action), trusted_runtime=runtime)
    _status_write(request_dir, "succeeded", "transport_succeeded")


def run_frontend_phase(phase: str, request_id: str, state_root: Path) -> None:
    if phase not in FRONTEND_PHASES or not SAFE_REQUEST_ID.fullmatch(request_id):
        raise TransportReject("frontend_phase_invalid")
    _, expected_slice, expected_uid = FRONTEND_PHASES[phase]
    if os.geteuid() != expected_uid:
        raise TransportReject("frontend_phase_identity_invalid")
    validate_cgroup(_current_control_group(), expected_slice)
    require_frontend_receipt_transport({})
    request_dir = _validated_frontend_phase_directory(request_id, phase)
    if phase == "builder":
        _quiet_run(["/usr/local/libexec/ken-actions/ken-frontend-production-release-build", "--request-dir", str(request_dir)], timeout=1800)
    elif phase == "uploader":
        fds = [_open_descriptor(request_dir / name) for name in ("source-maps.zip", "posthog-key", "posthog-project")]
        try:
            _quiet_run(["/usr/local/bin/ken-frontend-source-map-upload", "--endpoint", "https://us.posthog.com/api/projects/source_maps",
                        "--archive-fd", str(fds[0]), "--key-fd", str(fds[1]), "--project-fd", str(fds[2])], timeout=600, pass_fds=fds)
        finally:
            for fd in fds:
                os.close(fd)
    else:
        state_fd = _open_descriptor(request_dir / "digest-state.json")
        try:
            _quiet_run(["/usr/local/bin/ken-frontend-production-release", "execute-digest", "--state-fd", str(state_fd)], timeout=1200, pass_fds=(state_fd,))
        finally:
            os.close(state_fd)


def dispatch(request_id: str, state_root: Path, policy_path: Path) -> None:
    if os.geteuid() != 0:
        raise TransportReject("coordinator_not_root")
    request_dir, request = _load_request(state_root, request_id)
    policy = _load_policy(policy_path, request.policy_sha256)
    action = _action(policy, request.action_id)
    if action.get("enabled") is not True:
        raise TransportReject("action_not_enabled")
    mode = action.get("input_mode")
    scheduler = LeaseScheduler(state_root / "leases")
    lease: LeaseHandle | None = None
    try:
        if mode == "production_build":
            require_frontend_receipt_transport(action)
            lease = scheduler.wait_for_exclusive(request_id)
        else:
            lease = scheduler.wait_for_ordinary(request_id)
            unit, expected_slice = ORDINARY_SLOTS[lease.slots[0]]
            _start_fixed_unit(unit, expected_slice)
        _status_write(request_dir, "succeeded", "transport_succeeded")
    except Exception:
        if lease is not None:
            try:
                finish_transaction(scheduler, LiveRecoveryRuntime(state_root), lease)
                lease = None
            except TransportReject:
                pass
        else:
            scheduler.cancel_ordinary(request_id)
            LiveRecoveryRuntime(state_root).cleanup_request(LeaseHandle(request_id, (), "ordinary"))
        raise
    if lease is not None:
        finish_transaction(scheduler, LiveRecoveryRuntime(state_root), lease)


def validate_manifest_schema(manifest: Any) -> Mapping[str, Any]:
    value = _exact_keys(manifest, {
        "schema_version", "transport_version", "status", "enabled", "installation_authorized",
        "live_execution_authorized", "authorities", "task6_core", "task6_final", "leases",
        "artifacts", "task6_bindings",
    }, "manifest_schema_invalid")
    if (type(value["schema_version"]) is not int or value["schema_version"] != 1
            or value["transport_version"] != "2026-08-20.1"
            or value["status"] != "reviewed-transport-awaiting-task6-final-bindings"
            or value["enabled"] is not False or value["installation_authorized"] is not False
            or value["live_execution_authorized"] is not False):
        raise TransportReject("manifest_state_invalid")
    if value["authorities"] != {"plan_sha256": PLAN_SHA256, "matrix_sha256": MATRIX_SHA256}:
        raise TransportReject("manifest_authority_invalid")
    expected_core = {
        "integrated_commit_sha": "63c9e0b17ae8e894b85152de6f1ea26b33481930",
        "integrated_tree_sha": "df327c0de3ab5444011c41028f9dc9bc0e4248dd",
        "reviewed_source_commit_sha": "1eb21d952c202d301a0252125f9a7b8fdc010ef6",
        "reviewed_source_tree_sha": "1673e50129214f1e00c9926803be30b270148dae",
        "broker_sha256": "8d1c7859a1d4108e507d2f9a32acee8a1e26a10c212186fc751ab39e1c47d22e",
        "policy_sha256": TASK6_CORE_POLICY_SHA256,
        "runtime_lock_sha256": TASK6_CORE_LOCK_SHA256,
    }
    if value["task6_core"] != expected_core:
        raise TransportReject("manifest_core_invalid")
    if value["task6_final"] != {"status": "unavailable", "commit_sha": None, "policy_sha256": None, "runtime_lock_sha256": None}:
        raise TransportReject("manifest_final_binding_invalid")
    if value["leases"] != {
        "ordinary_slots": [
            {"slot": 1, "unit": "ken-actions-deploy-transaction-1.service", "slice": "ken-actions-deploy-transaction-1.slice"},
            {"slot": 2, "unit": "ken-actions-deploy-transaction-2.service", "slice": "ken-actions-deploy-transaction-2.slice"},
        ],
        "writer_preference": True, "production_build_holds_both": True,
        "recovery": "stop-reap-cgroup-empty-cleanup-then-release",
    }:
        raise TransportReject("manifest_lease_invalid")
    expected_artifacts = {
        "coordinator": "bin/ken-actions-deploy-transaction",
        "ordinary_slot_1": "systemd/ken-actions-deploy-transaction-1.service",
        "ordinary_slot_2": "systemd/ken-actions-deploy-transaction-2.service",
        "frontend_builder": "systemd/ken-frontend-production-builder@.service",
        "frontend_uploader": "systemd/ken-frontend-source-map-uploader@.service",
        "frontend_deploy": "systemd/ken-frontend-deploy-executor@.service",
    }
    artifacts = _exact_keys(value["artifacts"], set(expected_artifacts), "manifest_artifact_invalid")
    for name, relative in expected_artifacts.items():
        row = _exact_keys(artifacts[name], {"path", "sha256"}, "manifest_artifact_invalid")
        if row["path"] != relative or not isinstance(row["sha256"], str) or not SHA256.fullmatch(row["sha256"]):
            raise TransportReject("manifest_artifact_invalid")
    expected_bindings = {
        "ordinary_systemd_transaction_transport_sha256", "frontend_operation_binding_sha256",
        "frontend_phase_transport_sha256", "frontend_deploy_contract_sha256",
        "trusted_generation_dependency_acquisition_sha256", "trusted_generation_generated_paths_manifest_sha256",
        "trusted_generation_commit_input_contract_sha256", "trusted_generation_cgroup_contract_sha256",
        "trusted_generation_phase_transport_sha256",
    }
    bindings = _exact_keys(value["task6_bindings"], expected_bindings, "manifest_binding_invalid")
    if any(not isinstance(digest, str) or not SHA256.fullmatch(digest) for digest in bindings.values()):
        raise TransportReject("manifest_binding_invalid")
    return value


def verify_manifest(manifest_path: Path, policy_path: Path, runtime_lock_path: Path) -> None:
    manifest = validate_manifest_schema(strict_yaml(manifest_path))
    core = manifest["task6_core"]
    if core.get("policy_sha256") != hashlib.sha256(_regular_root_file(policy_path)).hexdigest():
        raise TransportReject("manifest_policy_invalid")
    if core.get("runtime_lock_sha256") != hashlib.sha256(_regular_root_file(runtime_lock_path)).hexdigest():
        raise TransportReject("manifest_runtime_lock_invalid")
    if manifest["task6_bindings"] != binding_digests():
        raise TransportReject("manifest_binding_invalid")
    for row in manifest["artifacts"].values():
        if _artifact_hash(row["path"]) != row["sha256"]:
            raise TransportReject("manifest_artifact_invalid")


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Ken deployment transaction transport")
    sub = parser.add_subparsers(dest="command", required=True)
    verify = sub.add_parser("verify")
    verify.add_argument("--manifest", type=Path, default=DEFAULT_MANIFEST)
    verify.add_argument("--policy", type=Path, default=DEFAULT_POLICY)
    verify.add_argument("--runtime-lock", type=Path, default=DEFAULT_RUNTIME_LOCK)
    sub.add_parser("contract-digests")
    dispatch_parser = sub.add_parser("dispatch")
    dispatch_parser.add_argument("--request-id", required=True)
    dispatch_parser.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    dispatch_parser.add_argument("--policy", type=Path, default=DEFAULT_POLICY)
    ordinary = sub.add_parser("run-ordinary-slot")
    ordinary.add_argument("--slot", required=True, type=int, choices=(1, 2))
    ordinary.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    ordinary.add_argument("--policy", type=Path, default=DEFAULT_POLICY)
    frontend = sub.add_parser("run-frontend-phase")
    frontend.add_argument("--phase", required=True, choices=tuple(FRONTEND_PHASES))
    frontend.add_argument("--request-id", required=True)
    frontend.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    trusted = sub.add_parser("run-trusted-phase")
    trusted.add_argument("--role", required=True, choices=("dependency", "generate", "push"))
    trusted.add_argument("--slot", required=True, type=int, choices=(1, 2))
    trusted.add_argument("--request-id", required=True)
    trusted.add_argument("--first-fd", required=True, type=int)
    trusted.add_argument("--second-fd", required=True, type=int)
    trusted.add_argument("--parent-sha")
    recover = sub.add_parser("recover")
    recover.add_argument("--state-root", type=Path, default=DEFAULT_STATE_ROOT)
    args = parser.parse_args(argv)
    try:
        if args.command == "verify":
            verify_manifest(args.manifest, args.policy, args.runtime_lock)
        elif args.command == "contract-digests":
            print(json.dumps(binding_digests(), sort_keys=True, separators=(",", ":")))
        elif args.command == "dispatch":
            dispatch(args.request_id, args.state_root, args.policy)
        elif args.command == "run-ordinary-slot":
            run_ordinary_slot(args.slot, args.state_root, args.policy)
        elif args.command == "run-frontend-phase":
            run_frontend_phase(args.phase, args.request_id, args.state_root)
        elif args.command == "run-trusted-phase":
            run_trusted_phase(args.role, args.slot, args.request_id, (args.first_fd, args.second_fd), args.parent_sha)
        else:
            LeaseScheduler(args.state_root / "leases").recover(LiveRecoveryRuntime(args.state_root))
        return 0
    except (TransportReject, OSError, subprocess.SubprocessError, ValueError):
        return 78


if __name__ == "__main__":
    raise SystemExit(main())
