def validate_generated_diff(entries: Any) -> tuple[str, ...]:
    if not isinstance(entries, list) or len(entries) > 10000:
        raise TransportReject("generated_manifest_invalid")
    seen: set[str] = set()
    total = 0
    accepted: list[str] = []
    for entry in entries:
        row = _exact_keys(entry, {"path", "type", "mode", "size", "sha256"}, "generated_entry_invalid")
        path = row["path"]
        if not isinstance(path, str) or not path or "\\" in path or "\x00" in path:
            raise TransportReject("generated_path_invalid")
        pure = PurePosixPath(path)
        if pure.is_absolute() or any(part in {"", ".", ".."} for part in pure.parts):
            raise TransportReject("generated_path_invalid")
        canonical = pure.as_posix()
        inside_images = canonical.startswith(GENERATED_DIRECTORY + "/") and canonical != GENERATED_DIRECTORY
        if canonical not in GENERATED_EXACT_PATHS and not inside_images:
            raise TransportReject("generated_path_invalid")
        folded = canonical.casefold()
        if folded in seen:
            raise TransportReject("generated_path_duplicate")
        seen.add(folded)
        if row["type"] == "delete":
            if not inside_images or row["mode"] is not None or row["size"] != 0 or row["sha256"] is not None:
                raise TransportReject("generated_type_invalid")
        else:
            if row["type"] != "file" or row["mode"] != "100644":
                raise TransportReject("generated_type_invalid")
            if type(row["size"]) is not int or not 0 <= row["size"] <= GENERATED_FILE_MAX:
                raise TransportReject("generated_size_invalid")
            if not isinstance(row["sha256"], str) or not SHA256.fullmatch(row["sha256"]):
                raise TransportReject("generated_digest_invalid")
        total += row["size"]
        if total > GENERATED_TOTAL_MAX:
            raise TransportReject("generated_size_invalid")
        accepted.append(canonical)
    return tuple(accepted)


def generated_diff_from_snapshots(baseline: Mapping[str, Mapping[str, Any]], generated: Mapping[str, Mapping[str, Any]]) -> list[dict[str, Any]]:
    entries: list[dict[str, Any]] = []
    for path in sorted(set(baseline) | set(generated), key=lambda item: (item.casefold(), item)):
        before = baseline.get(path); after = generated.get(path)
        if before == after:
            continue
        if after is None:
            entries.append({"path": path, "type": "delete", "mode": None, "size": 0, "sha256": None})
        else:
            entries.append({"path": path, "type": "file", **after})
    validate_generated_diff(entries)
    return entries


def orchestrate_trusted_generation(runtime: Any, slot: int) -> None:
    """Run the split Beehiiv transaction through a narrow runtime adapter.

    Dependency preparation is credential-free.  The generator is synchronously
    reaped before root validation/sealing.  Generator descriptors are closed
    before the distinct push identity can start.  Any exception invokes the
    runtime's fail-closed process/descriptor/request cleanup boundary.
    """
    if slot not in ORDINARY_SLOTS:
        raise TransportReject("trusted_generation_slot_invalid")
    contract = trusted_generation_contract()
    try:
        runtime.prepare_dependencies(contract["dependency"])
        runtime.start_generate(contract["generate"])
        runtime.stop_and_reap("generate")
        entries = runtime.generated_diff()
        validate_generated_diff(entries)
        if not entries:
            runtime.close_generate_descriptors()
            runtime.close_push_descriptors()
            return
        sealed = runtime.seal_commit_input(entries)
        if sealed is None:
            raise TransportReject("commit_input_unsealed")
        runtime.close_generate_descriptors()
        runtime.start_push(contract["push"], sealed)
        runtime.stop_and_reap("push")
        runtime.close_push_descriptors()
    except Exception:
        runtime.abort_cleanup()
        raise


def execute_action_mode(mode: str, *, slot: int, ordinary: Any, trusted_runtime: Any) -> None:
    if mode in ORDINARY_DESCRIPTOR_CONTRACTS:
        ordinary()
        return
    if mode == "trusted_generation" and trusted_runtime is not None:
        orchestrate_trusted_generation(trusted_runtime, slot)
        return
    raise TransportReject("ordinary_mode_invalid")


@dataclasses.dataclass
class FrontendPhaseState:
    order: tuple[str, ...] = (
        "source-ready", "dependencies-ready", "secret-build", "builder-reaped",
        "scan-passed", "uploader", "uploader-reaped", "registry-readback",
        "token-destroyed", "deploy", "deploy-reaped", "cleaned",
    )
    index: int = 0
    active_role: str | None = None

    @property
    def complete(self) -> bool:
        return self.index == len(self.order) and self.active_role is None

    def advance(self, phase: str) -> None:
        if self.index >= len(self.order) or self.order[self.index] != phase:
            raise TransportReject("frontend_phase_order_invalid")
        transitions = {
            "secret-build": "builder",
            "builder-reaped": None,
            "uploader": "uploader",
            "uploader-reaped": None,
            "deploy": "deploy",
            "deploy-reaped": None,
        }
        if phase in {"uploader", "deploy"} and self.active_role is not None:
            raise TransportReject("frontend_phase_overlap")
        if phase in {"builder-reaped", "uploader-reaped", "deploy-reaped"}:
            expected = {"builder-reaped": "builder", "uploader-reaped": "uploader", "deploy-reaped": "deploy"}[phase]
            if self.active_role not in {expected, None}:  # replayed receipt-only unit tests may not call start_role.
                raise TransportReject("frontend_phase_overlap")
        if phase in transitions:
            self.active_role = transitions[phase]
        self.index += 1

    def start_role(self, role: str) -> None:
        if role not in {"builder", "uploader", "deploy"} or self.active_role is not None:
            raise TransportReject("frontend_phase_overlap")
        allowed_index = {"builder": 2, "uploader": 5, "deploy": 9}[role]
        if self.index != allowed_index:
            raise TransportReject("frontend_phase_order_invalid")
        self.active_role = role

    def stop_role(self, role: str) -> None:
        if self.active_role != role:
            raise TransportReject("frontend_phase_overlap")
        self.active_role = None


def frontend_phase_directory(request_id: str, phase: str) -> tuple[Path, int]:
    if not SAFE_REQUEST_ID.fullmatch(request_id) or phase not in FRONTEND_PHASES:
        raise TransportReject("frontend_phase_invalid")
    return Path(f"/run/ken-actions-deploy-phases/{request_id}-{phase}"), FRONTEND_PHASES[phase][2]


def require_frontend_receipt_transport(action: Mapping[str, Any]) -> None:
    """Task 6 core contains placeholders, so no receipt may be fabricated here."""
    raise TransportReject("frontend_receipt_transport_unavailable")


def _validated_frontend_phase_directory(request_id: str, phase: str) -> Path:
    path, identity = frontend_phase_directory(request_id, phase)
    if path.is_symlink():
        raise TransportReject("frontend_phase_directory_invalid")
    status = path.stat()
    marker = path / ".ken-frontend-phase"
    output = path / "output"
    if (not stat.S_ISDIR(status.st_mode) or status.st_uid != 0 or status.st_gid != identity or stat.S_IMODE(status.st_mode) != 0o750
            or marker.is_symlink() or not marker.is_file() or marker.stat().st_uid != 0 or marker.stat().st_mode & 0o022
            or output.is_symlink() or not output.is_dir() or output.stat().st_uid != identity or output.stat().st_gid != identity
            or stat.S_IMODE(output.stat().st_mode) != 0o700):
        raise TransportReject("frontend_phase_directory_invalid")
    return path


def _repo_root() -> Path:
    path = Path(__file__).resolve()
    if path.parent.name == "bin" and path.parent.parent.name == "github-actions":
        return path.parent.parent
    return Path("/usr/local/libexec/ken-actions")


def _artifact_hash(relative: str) -> str:
    root = _repo_root()
    path = root / relative if root.name == "github-actions" else Path(TRANSPORT_PATH if relative == "bin/ken-actions-deploy-transaction" else f"/etc/systemd/system/{Path(relative).name}")
    try:
        return hashlib.sha256(path.read_bytes()).hexdigest()
    except OSError as exc:
        raise TransportReject("transport_artifact_missing") from exc


