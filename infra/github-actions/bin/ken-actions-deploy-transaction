            "availability": "blocked-until-task6-exact-receipts-and-handoffs",
        },
        "frontend_phase_transport_sha256": {
            "version": 1, "coordinator_sha256": coordinator,
            "units": {"builder": units["builder"], "uploader": units["uploader"]},
            "order": list(FrontendPhaseState().order), "exclusive_slots": [1, 2],
            "firewall_phases": [list(item) for item in FRONTEND_FIREWALL_PHASES],
