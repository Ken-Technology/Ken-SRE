    }
    trusted = trusted_generation_contract()
    return {
        "ordinary_systemd_transaction_transport_sha256": {
            "version": 1, "coordinator_sha256": coordinator,
            "units": {"slot-1": units["ordinary_1"], "slot-2": units["ordinary_2"]},
            "slots": [1, 2], "modes": ["artifact", "source_commit", "registry"],
            "request_id": "64-lowercase-hex-root-created",
            "firewall_phases": {key: [list(item) for item in value] for key, value in ORDINARY_FIREWALL_PHASES.items()},
            "writer_preference": True, "recovery": "stop-reap-cgroup-empty-cleanup-then-release",
        },
        "frontend_operation_binding_sha256": {
            "version": 1, "action_id": "ken-frontend-production-release", "coordinator_sha256": coordinator,
            "source": "broker-authenticated-pinned-source", "runner_output": "stable-code-only",
