#!/usr/bin/env python3
"""Fail-closed systemd transport for broker-authorized Ken deployments.

The Actions runner never invokes this program.  A root broker writes a sealed,
root-owned request and calls ``dispatch`` with only its request id.  Policy,
identity, slice, command, target, paths and network profile are selected from
root-owned files.  The client receives only the broker's stable result code.
"""

from __future__ import annotations

