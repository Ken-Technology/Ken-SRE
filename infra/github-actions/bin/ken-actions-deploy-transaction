class TransportReject(Exception):
    def __init__(self, code: str):
        self.code = code if SAFE_REASON.fullmatch(code) else "transport_rejected"
        super().__init__(self.code)


class LeaseUnavailable(TransportReject):
    pass


def _pairs_no_duplicates(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise TransportReject("json_duplicate_key")
        result[key] = value
    return result


def strict_json(data: bytes, *, maximum: int = 65536) -> Any:
    if not data or len(data) > maximum:
        raise TransportReject("json_size_invalid")
    try:
        return json.loads(data.decode("utf-8"), object_pairs_hook=_pairs_no_duplicates)
    except TransportReject:
        raise
    except (UnicodeError, ValueError, TypeError, json.JSONDecodeError) as exc:
        raise TransportReject("json_invalid") from exc


def strict_yaml(path: Path) -> Any:
    if yaml is None:
        raise TransportReject("yaml_runtime_missing")

    class Loader(yaml.SafeLoader):
        pass

    def mapping(loader: Loader, node: Any, deep: bool = False) -> dict[Any, Any]:
        result: dict[Any, Any] = {}
        for key_node, value_node in node.value:
            key = loader.construct_object(key_node, deep=deep)
            if key in result:
                raise TransportReject("yaml_duplicate_key")
            result[key] = loader.construct_object(value_node, deep=deep)
        return result

    Loader.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG, mapping)
    try:
        text = path.read_text(encoding="utf-8")
        for event in yaml.parse(text):
            if isinstance(event, yaml.AliasEvent) or getattr(event, "anchor", None) is not None or getattr(event, "tag", None) is not None:
                raise TransportReject("yaml_feature_forbidden")
        return yaml.load(text, Loader=Loader)
    except TransportReject:
        raise
    except (OSError, UnicodeError, yaml.YAMLError) as exc:
        raise TransportReject("yaml_invalid") from exc


def _exact_keys(value: Any, expected: set[str], code: str) -> Mapping[str, Any]:
    if not isinstance(value, dict) or set(value) != expected:
        raise TransportReject(code)
    return value


@dataclasses.dataclass(frozen=True)
class TransportRequest:
    version: int
    request_id: str
    action_id: str
    policy_sha256: str
    source_sha: str
    descriptors: tuple[str, ...]

    @classmethod
    def parse(cls, data: bytes) -> "TransportRequest":
        value = _exact_keys(strict_json(data), {
            "version", "request_id", "action_id", "policy_sha256", "source_sha", "descriptors",
        }, "request_schema_invalid")
        if type(value["version"]) is not int or value["version"] != 1:
            raise TransportReject("request_schema_invalid")
        if not isinstance(value["request_id"], str) or not SAFE_REQUEST_ID.fullmatch(value["request_id"]):
            raise TransportReject("request_id_invalid")
        if not isinstance(value["action_id"], str) or not SAFE_ACTION_ID.fullmatch(value["action_id"]):
            raise TransportReject("request_action_invalid")
        if not isinstance(value["policy_sha256"], str) or not SHA256.fullmatch(value["policy_sha256"]):
            raise TransportReject("request_policy_invalid")
        if not isinstance(value["source_sha"], str) or not SHA1.fullmatch(value["source_sha"]):
            raise TransportReject("request_source_invalid")
        descriptors = value["descriptors"]
        if (not isinstance(descriptors, list) or any(not isinstance(item, str) for item in descriptors)
                or len(descriptors) != len(set(descriptors)) or len(descriptors) > 8):
            raise TransportReject("request_descriptors_invalid")
        return cls(value["version"], value["request_id"], value["action_id"], value["policy_sha256"], value["source_sha"], tuple(descriptors))


def descriptor_contract(mode: str) -> tuple[str, ...]:
    try:
        return ORDINARY_DESCRIPTOR_CONTRACTS[mode]
    except KeyError as exc:
        raise TransportReject("descriptor_mode_invalid") from exc


def validate_descriptor_contract(mode: str, descriptors: Sequence[str]) -> None:
    if tuple(descriptors) != descriptor_contract(mode):
        raise TransportReject("descriptor_contract_invalid")


@dataclasses.dataclass(frozen=True)
class LeaseHandle:
    request_id: str
    slots: tuple[int, ...]
    kind: str


class LeaseScheduler:
    """Durable two-slot writer-preferring gate.

    Lease marker files intentionally survive a coordinator crash.  Recovery
    removes them only after the owning unit/process group is stopped and
    reaped, its cgroup is empty, and the marked request directory is cleaned.
    """

    def __init__(self, root: Path):
        self.root = root
        self.root.mkdir(parents=True, exist_ok=True, mode=0o700)
        try:
            os.chmod(self.root, 0o700)
        except OSError:
            pass
        self.scheduler_path = self.root / "scheduler.lock"
        self.writer_path = self.root / "writer-pending.json"
        self.waiter_root = self.root / "ordinary-waiters"
        self.waiter_root.mkdir(mode=0o700, exist_ok=True)
        os.chmod(self.waiter_root, 0o700)

    def _locked(self):
        fd = os.open(self.scheduler_path, os.O_CREAT | os.O_RDWR | os.O_CLOEXEC, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX)
        return fd

    def _slot_path(self, slot: int) -> Path:
        if slot not in ORDINARY_SLOTS:
            raise TransportReject("lease_slot_invalid")
        return self.root / f"slot-{slot}.json"

    @staticmethod
    def _payload(handle: LeaseHandle, slot: int) -> bytes:
        return json.dumps({
            "version": 1,
            "request_id": handle.request_id,
            "kind": handle.kind,
            "slot": slot,
            "slots": list(handle.slots),
        }, sort_keys=True, separators=(",", ":")).encode()

    def _create_marker(self, path: Path, payload: bytes) -> None:
        fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0), 0o600)
        try:
            os.write(fd, payload)
            os.fsync(fd)
        finally:
            os.close(fd)

    def _read_marker(self, path: Path) -> LeaseHandle:
        value = _exact_keys(strict_json(path.read_bytes(), maximum=4096), {"version", "request_id", "kind", "slot", "slots"}, "lease_marker_invalid")
        if type(value["version"]) is not int or value["version"] != 1:
            raise TransportReject("lease_marker_invalid")
        if not isinstance(value["request_id"], str) or not SAFE_REQUEST_ID.fullmatch(value["request_id"]):
            raise TransportReject("lease_marker_invalid")
        if value["kind"] not in {"ordinary", "production_build"}:
            raise TransportReject("lease_marker_invalid")
        if type(value["slot"]) is not int or value["slot"] not in ORDINARY_SLOTS:
            raise TransportReject("lease_marker_invalid")
        if value["slots"] not in ([1], [2], [1, 2]):
            raise TransportReject("lease_marker_invalid")
        handle = LeaseHandle(value["request_id"], tuple(value["slots"]), value["kind"])
        if value["slot"] not in handle.slots or (handle.kind == "ordinary") != (len(handle.slots) == 1):
            raise TransportReject("lease_marker_invalid")
        return handle

    def _read_waiter(self, path: Path) -> Mapping[str, Any]:
        value = _exact_keys(strict_json(path.read_bytes(), maximum=2048), {
            "version", "request_id", "sequence", "pid", "boot_id", "start_ticks",
        }, "ordinary_waiter_invalid")
        if (type(value["version"]) is not int or value["version"] != 1
                or not isinstance(value["request_id"], str) or not SAFE_REQUEST_ID.fullmatch(value["request_id"])
                or type(value["sequence"]) is not int or value["sequence"] <= 0
                or type(value["pid"]) is not int or value["pid"] <= 0
                or not isinstance(value["boot_id"], str) or not value["boot_id"]
                or type(value["start_ticks"]) is not int or value["start_ticks"] < 0
                or path.name != f"{value['sequence']:020d}-{value['request_id']}.json"):
            raise TransportReject("ordinary_waiter_invalid")
        return value

    def _waiters_locked(self) -> list[tuple[Path, Mapping[str, Any]]]:
        rows: list[tuple[Path, Mapping[str, Any]]] = []
        for path in sorted(self.waiter_root.iterdir(), key=lambda item: item.name):
            if path.is_symlink() or not path.is_file():
                raise TransportReject("ordinary_waiter_invalid")
            rows.append((path, self._read_waiter(path)))
        return rows

    def ordinary_waiters(self) -> tuple[str, ...]:
        lock = self._locked()
        try:
            return tuple(row["request_id"] for _, row in self._waiters_locked())
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN); os.close(lock)

    def enqueue_ordinary(self, request_id: str) -> int:
        if not SAFE_REQUEST_ID.fullmatch(request_id):
            raise TransportReject("lease_request_invalid")
        lock = self._locked()
        try:
            rows = self._waiters_locked()
            existing = [row for _, row in rows if row["request_id"] == request_id]
            if existing:
                if len(existing) != 1:
                    raise TransportReject("ordinary_waiter_invalid")
                return int(existing[0]["sequence"])
            sequence = max((int(row["sequence"]) for _, row in rows), default=0) + 1
            boot_id, start_ticks = _process_identity(os.getpid())
            handle = {
                "version": 1, "request_id": request_id, "sequence": sequence, "pid": os.getpid(),
                "boot_id": boot_id, "start_ticks": start_ticks,
            }
            self._create_marker(self.waiter_root / f"{sequence:020d}-{request_id}.json",
                                json.dumps(handle, sort_keys=True, separators=(",", ":")).encode())
            return sequence
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN); os.close(lock)

    def cancel_ordinary(self, request_id: str) -> None:
        lock = self._locked()
        try:
            rows = [(path, row) for path, row in self._waiters_locked() if row["request_id"] == request_id]
            if len(rows) > 1:
                raise TransportReject("ordinary_waiter_invalid")
            if rows:
                rows[0][0].unlink()
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN); os.close(lock)

    def acquire_ordinary(self, request_id: str, *, from_queue: bool = False) -> LeaseHandle:
        if not SAFE_REQUEST_ID.fullmatch(request_id):
            raise TransportReject("lease_request_invalid")
        lock = self._locked()
        try:
            if self.writer_path.exists():
                raise LeaseUnavailable("lease_exclusive_waiting")
            waiters = self._waiters_locked()
            if waiters:
                if not from_queue or waiters[0][1]["request_id"] != request_id:
                    raise LeaseUnavailable("lease_ordinary_queued")
            elif from_queue:
                raise TransportReject("ordinary_waiter_missing")
            for slot in ORDINARY_SLOTS:
                path = self._slot_path(slot)
                if path.exists():
                    continue
                handle = LeaseHandle(request_id, (slot,), "ordinary")
                try:
                    self._create_marker(path, self._payload(handle, slot))
                    if from_queue:
                        waiters[0][0].unlink()
                    return handle
                except FileExistsError:
                    continue
            raise LeaseUnavailable("lease_capacity")
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)
            os.close(lock)

    def wait_for_ordinary(self, request_id: str, *, timeout: float = 300.0, wait: Any = time.sleep,
                          cancelled: Any = lambda: False) -> LeaseHandle:
        self.enqueue_ordinary(request_id)
        deadline = time.monotonic() + max(0.0, timeout)
        try:
            while True:
                if cancelled():
                    raise LeaseUnavailable("lease_ordinary_cancelled")
                try:
                    return self.acquire_ordinary(request_id, from_queue=True)
                except LeaseUnavailable as exc:
                    if exc.code not in {"lease_capacity", "lease_exclusive_waiting", "lease_ordinary_queued"}:
                        raise
                    if time.monotonic() >= deadline:
                        raise LeaseUnavailable("lease_ordinary_timeout")
                    wait(min(0.1, max(0.0, deadline - time.monotonic())))
        except Exception:
            self.cancel_ordinary(request_id)
            raise

    def announce_writer(self, request_id: str) -> None:
        if not SAFE_REQUEST_ID.fullmatch(request_id):
            raise TransportReject("lease_request_invalid")
        lock = self._locked()
        try:
            if self.writer_path.exists():
                current = self._read_writer()
                if current["request_id"] != request_id:
                    raise LeaseUnavailable("lease_writer_queued")
                return
            boot_id, start_ticks = _process_identity(os.getpid())
            payload = json.dumps({
                "version": 1, "request_id": request_id, "pid": os.getpid(),
                "boot_id": boot_id, "start_ticks": start_ticks,
            }, sort_keys=True, separators=(",", ":")).encode()
            self._create_marker(self.writer_path, payload)
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)
            os.close(lock)

    def acquire_exclusive(self, request_id: str) -> LeaseHandle:
        if not SAFE_REQUEST_ID.fullmatch(request_id):
            raise TransportReject("lease_request_invalid")
        lock = self._locked()
        created: list[Path] = []
        try:
            if not self.writer_path.exists():
                raise TransportReject("lease_writer_not_announced")
            writer = self._read_writer()
            if writer["request_id"] != request_id:
                raise LeaseUnavailable("lease_writer_queued")
            if any(self._slot_path(slot).exists() for slot in ORDINARY_SLOTS):
                raise LeaseUnavailable("lease_capacity")
            handle = LeaseHandle(request_id, (1, 2), "production_build")
            for slot in ORDINARY_SLOTS:
                path = self._slot_path(slot)
                self._create_marker(path, self._payload(handle, slot))
                created.append(path)
            self.writer_path.unlink()
            return handle
        except Exception:
            for path in created:
                try:
                    path.unlink()
                except FileNotFoundError:
                    pass
            raise
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)
            os.close(lock)

    def _read_writer(self) -> Mapping[str, Any]:
        value = _exact_keys(strict_json(self.writer_path.read_bytes(), maximum=2048), {
            "version", "request_id", "pid", "boot_id", "start_ticks",
        }, "writer_marker_invalid")
        if (type(value["version"]) is not int or value["version"] != 1
                or not isinstance(value["request_id"], str) or not SAFE_REQUEST_ID.fullmatch(value["request_id"])
                or type(value["pid"]) is not int or value["pid"] <= 0
                or not isinstance(value["boot_id"], str) or not value["boot_id"]
                or type(value["start_ticks"]) is not int or value["start_ticks"] < 0):
            raise TransportReject("writer_marker_invalid")
        return value

    def cancel_writer(self, request_id: str) -> None:
        lock = self._locked()
        try:
            if not self.writer_path.exists():
                return
            if self._read_writer()["request_id"] != request_id:
                raise LeaseUnavailable("lease_writer_queued")
            self.writer_path.unlink()
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)
            os.close(lock)

    def wait_for_exclusive(self, request_id: str, *, timeout: float = 300.0, wait: Any = time.sleep) -> LeaseHandle:
        self.announce_writer(request_id)
        deadline = time.monotonic() + max(0.0, timeout)
        try:
            while True:
                try:
                    return self.acquire_exclusive(request_id)
                except LeaseUnavailable as exc:
                    if exc.code != "lease_capacity":
                        raise
                    if time.monotonic() >= deadline:
                        raise LeaseUnavailable("lease_exclusive_timeout")
                    wait(min(0.1, max(0.0, deadline - time.monotonic())))
        except Exception:
            self.cancel_writer(request_id)
            raise

    def release(self, handle: LeaseHandle, *, cleanup_verified: bool) -> None:
        if not cleanup_verified:
            raise TransportReject("lease_cleanup_unverified")
        lock = self._locked()
        try:
            for slot in handle.slots:
                path = self._slot_path(slot)
                if not path.exists() or self._read_marker(path) != handle:
                    raise TransportReject("lease_release_mismatch")
            for slot in handle.slots:
                self._slot_path(slot).unlink()
            if handle.kind == "production_build" and self.writer_path.exists():
                writer = strict_json(self.writer_path.read_bytes(), maximum=1024)
                if isinstance(writer, dict) and writer.get("request_id") == handle.request_id:
                    self.writer_path.unlink()
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)
            os.close(lock)

    def active_leases(self) -> tuple[LeaseHandle, ...]:
        found: dict[tuple[str, str], LeaseHandle] = {}
        for slot in ORDINARY_SLOTS:
            path = self._slot_path(slot)
            if path.exists():
                handle = self._read_marker(path)
                found[(handle.request_id, handle.kind)] = handle
        return tuple(sorted(found.values(), key=lambda item: (item.request_id, item.kind)))

    def recover(self, runtime: Any) -> None:
        for handle in self.active_leases():
            finish_transaction(self, runtime, handle)
        if self.writer_path.exists():
            writer = self._read_writer()
            if not _writer_alive(writer):
                pending = LeaseHandle(writer["request_id"], (), "production_build")
                if runtime.cleanup_request(pending) is not True:
                    raise TransportReject("recovery_cleanup_failed")
                self.cancel_writer(writer["request_id"])

        lock = self._locked()
        try:
            waiters = list(self._waiters_locked())
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)
            os.close(lock)
        for path, waiter in waiters:
            if _writer_alive(waiter):
                continue
            pending = LeaseHandle(str(waiter["request_id"]), (), "ordinary")
            if runtime.cleanup_request(pending) is not True:
                raise TransportReject("recovery_cleanup_failed")
            lock = self._locked()
            try:
                if not path.exists():
                    continue
                current = self._read_waiter(path)
                if current != waiter or _writer_alive(current):
                    raise TransportReject("ordinary_waiter_recovery_raced")
                path.unlink()
            finally:
                fcntl.flock(lock, fcntl.LOCK_UN)
                os.close(lock)


def finish_transaction(scheduler: LeaseScheduler, runtime: Any, lease: LeaseHandle) -> None:
    """Release a lease only after its processes and request bytes are gone."""
    if runtime.stop_and_reap(lease) is not True:
        raise TransportReject("transaction_reap_failed")
    if runtime.cleanup_request(lease) is not True:
        raise TransportReject("transaction_cleanup_failed")
    scheduler.release(lease, cleanup_verified=True)


def _process_identity(pid: int) -> tuple[str, int]:
    try:
        boot_id = Path("/proc/sys/kernel/random/boot_id").read_text().strip()
        fields = Path(f"/proc/{pid}/stat").read_text().split()
        if not boot_id or len(fields) < 22:
            raise OSError
        return boot_id, int(fields[21])
    except (OSError, ValueError):
        return "nonlinux-test", 0


def _writer_alive(writer: Mapping[str, Any]) -> bool:
    boot_id, start_ticks = _process_identity(int(writer["pid"]))
    return boot_id != "nonlinux-test" and (boot_id, start_ticks) == (writer["boot_id"], writer["start_ticks"])


def validate_cgroup(control_group: str, expected_slice: str) -> None:
    if not isinstance(control_group, str) or not control_group.startswith("/"):
        raise TransportReject("cgroup_parent_invalid")
    parts = [part for part in control_group.split("/") if part]
    prefix = ["ken.slice", "ken-actions.slice", "ken-actions-deploy.slice"]
    if (len(parts) < 5 or parts[:3] != prefix or parts.count("ken-actions-deploy.slice") != 1
            or parts.count(expected_slice) != 1 or parts.index(expected_slice) < 3
            or not parts[-1].endswith((".service", ".scope"))):
        raise TransportReject("cgroup_slice_invalid")
    expected_index = parts.index(expected_slice)
    if expected_slice.startswith("ken-actions-deploy-transaction-"):
        if parts[3:expected_index] != ["ken-actions-deploy-transaction.slice"]:
            raise TransportReject("cgroup_slice_invalid")
    elif expected_index != 3:
        raise TransportReject("cgroup_slice_invalid")
    if any(part in {"system.slice", "user.slice", "ken-deploy.slice", ".", ".."} for part in parts):
        raise TransportReject("cgroup_parent_invalid")
    leaf = parts[-1]
    allowed_leaf = False
    slot_match = re.fullmatch(r"ken-actions-deploy-transaction-([12])[.]slice", expected_slice)
    if slot_match:
        slot = slot_match.group(1)
        allowed_leaf = leaf == f"ken-actions-deploy-transaction-{slot}.service" or leaf in {
            f"ken-beehiiv-generate-slot-{slot}.scope", f"ken-beehiiv-push-slot-{slot}.scope",
        }
    else:
        templates = {
            "ken-actions-deploy-builder.slice": "ken-frontend-production-builder@",
            "ken-actions-deploy-uploader.slice": "ken-frontend-source-map-uploader@",
            "ken-actions-deploy-executor.slice": "ken-frontend-deploy-executor@",
        }
        prefix_name = templates.get(expected_slice)
        if prefix_name:
            allowed_leaf = bool(re.fullmatch(re.escape(prefix_name) + r"[0-9a-f]{64}[.]service", leaf))
    if not allowed_leaf:
        raise TransportReject("cgroup_leaf_invalid")


def firewall_phase_plan(action_id: str) -> tuple[tuple[str, str], ...]:
    try:
        return ORDINARY_FIREWALL_PHASES[action_id]
    except KeyError as exc:
        raise TransportReject("firewall_action_unbound") from exc


