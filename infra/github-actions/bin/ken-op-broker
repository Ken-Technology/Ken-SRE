except ImportError:  # runtime lock makes this fatal outside parser-only imports
    yaml = None

MAX_PACKET = 65536
MAX_OIDC = 16384
MAX_GITHUB_TOKEN = 4096
SHA1 = re.compile(r"^[0-9a-f]{40}$")
SHA256 = re.compile(r"^[0-9a-f]{64}$")
SAFE_REQUEST_ID = re.compile(r"^[0-9a-f]{32}$")
SAFE_REASON = re.compile(r"^[a-z][a-z0-9_]{0,63}$")
ALLOWED_REQUEST_KEYS = frozenset({"version", "action_id", "artifact_id", "oidc_jwt", "github_token"})
ALLOWED_RESPONSE_FIELDS = ("version", "request_id", "status", "reason_code")
ALLOWED_JOSE_HEADERS = frozenset({"typ", "alg", "kid"})
ALLOWED_LOG_FIELDS = frozenset({
