    "runner_name", "repository", "repository_id", "workflow", "workflow_sha",
    "environment", "run_id", "run_attempt", "check_run_id", "action_id",
    "artifact_id", "artifact_digest", "source_sha", "tree_sha", "manifest_sha256",
    "destination_id", "duration_ms", "executor_exit_class", "policy_version",
})
